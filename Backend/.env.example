# Copy to .env (git-ignored) and fill in for local docker-compose runs.
# Steamworks publisher key — from https://partner.steamgames.com, never commit the real value.
STEAM_PUBLISHER_KEY=
# Spacewar (480) is Valve's public Steamworks test AppID; replace with the real AppID once assigned.
STEAM_APP_ID=480
# HMAC signing key for backend session tokens (AD-10). Generate a real random secret for anything beyond localhost.
JWT_SIGNING_KEY=local-dev-only-signing-key-do-not-use-in-production-00000
